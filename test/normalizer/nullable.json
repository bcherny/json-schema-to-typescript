{
  "name": "Transform `nullable` to anyOf with null",
  "in": {
    "$id": "Nullable",
    "type": "object",
    "properties": {
      "typed": {
        "type": "string",
        "nullable": true,
        "description": "stays outside",
        "title": "Typed"
      },
      "untyped": {
        "properties": {
          "b": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "nullable": true
      },
      "enum": {
        "type": "string",
        "enum": [
          "a",
          "b"
        ],
        "nullable": true
      },
      "enumWithNull": {
        "type": "string",
        "enum": [
          "a",
          null
        ],
        "nullable": true
      },
      "constNull": {
        "const": null,
        "nullable": true
      },
      "typeWithNull": {
        "type": [
          "string",
          "null"
        ],
        "nullable": true
      },
      "notNullable": {
        "type": "string",
        "nullable": false
      },
      "namedEnum": {
        "type": "string",
        "enum": [
          "a",
          "b"
        ],
        "tsEnumNames": [
          "A",
          "B"
        ],
        "nullable": true
      },
      "annotationOnly": {
        "description": "constrains nothing, stays as it is",
        "nullable": true
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "out": {
    "$id": "Nullable",
    "type": "object",
    "properties": {
      "typed": {
        "description": "stays outside",
        "title": "Typed",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "untyped": {
        "anyOf": [
          {
            "properties": {
              "b": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": []
          },
          {
            "type": "null"
          }
        ]
      },
      "enum": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "a",
              "b"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "enumWithNull": {
        "type": "string",
        "enum": [
          "a",
          null
        ]
      },
      "constNull": {
        "enum": [
          null
        ]
      },
      "typeWithNull": {
        "type": [
          "string",
          "null"
        ]
      },
      "notNullable": {
        "type": "string",
        "nullable": false
      },
      "namedEnum": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "a",
              "b"
            ],
            "tsEnumNames": [
              "A",
              "B"
            ],
            "$id": "namedEnum"
          },
          {
            "type": "null"
          }
        ]
      },
      "annotationOnly": {
        "description": "constrains nothing, stays as it is",
        "nullable": true
      }
    },
    "required": [],
    "additionalProperties": false
  }
}

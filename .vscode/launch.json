{
  "version": "0.2.5",
  "configurations": [
    {
        "type": "node",
        "request": "launch",
        "name": "Run tests",
        "runtimeExecutable": "bun",
        "runtimeArgs": ["test"],
        "cwd": "${workspaceRoot}"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Process",
      "processId": "${command:PickProcess}",
      "port": 5858,
      "sourceMaps": true
    }
  ]
}
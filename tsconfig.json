{
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "es2015"
    ],
    "module": "node20",
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    // Tests are no longer compiled (see tsconfig.test.json), so pin the root to
    // keep emitting dist/src/* rather than flattening it to dist/*.
    "rootDir": ".",
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es6",
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": false
  },
  "exclude": [
    "bench",
    "dist",
    "example",
    "node_modules",
    "test"
  ]
}
